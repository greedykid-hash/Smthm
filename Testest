-- 2. Initialize the UI Window
local Window = UI_Library.Init()

-- Create the main tab for Auto-Farm controls
local MainTabCanvas = Window:CreateTab("rbxassetid://6031068426") -- Home Icon

---------------------------------------------------------
-- FARMING LOGIC & VARIABLES
---------------------------------------------------------
local farming = false
local vehicleSeat = nil
local carModel = nil
local player = game.Players.LocalPlayer
local farmThread = nil

-- Default Farm Coordinates
local farmX, farmY, farmZ = 0, 10, 0

-- Find player's car in workspace
local function findCar()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("VehicleSeat") then
            -- Check if player is currently sitting in it
            if v.Occupant and v.Occupant.Parent == player.Character then
                vehicleSeat = v
                carModel = v.Parent
                return true
            end
            
            -- Check vehicle ownership value
            local owner = v.Parent and v.Parent:FindFirstChild("Owner")
            if owner and owner.Value == player then
                vehicleSeat = v
                carModel = v.Parent
                return true
            end
        end
    end
    return false
end

-- Teleport car to specified farm coordinates
local function teleport()
    if carModel then
        local primary = carModel.PrimaryPart or vehicleSeat
        if primary then
            primary.CFrame = CFrame.new(farmX, farmY, farmZ)
        end
    end
end

-- Anti-AFK Routine
task.spawn(function()
    while true do
        if workspace.CurrentCamera and farming then
            workspace.CurrentCamera.CFrame = workspace.CurrentCamera.CFrame * CFrame.Angles(0, 0, 0.001)
        end
        task.wait(5)
    end
end)

-- Start Auto-Farm
local function startFarm()
    if farming then return end
    farming = true
    
    farmThread = task.spawn(function()
        while farming do
            if findCar() then
                teleport()
                
                -- Apply steering and throttle to gain continuous drift score
                if vehicleSeat then
                    vehicleSeat.SteerFloat = 1
                    vehicleSeat.ThrottleFloat = 1
                end
            end
            task.wait(0.1)
        end
    end)
end

-- Stop Auto-Farm
local function stopFarm()
    farming = false
    if farmThread then
        task.cancel(farmThread)
        farmThread = nil
    end
    
    if vehicleSeat then
        vehicleSeat.SteerFloat = 0
        vehicleSeat.ThrottleFloat = 0
    end
end

