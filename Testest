InputBox.Position = UDim2.new(0, 10, 0, 60)
InputBox.BackgroundColor3 = Color3.fromRGB(38, 38, 45)
InputBox.PlaceholderText = "Farm Position (X, Y, Z e.g. 0, 10, 0)"
