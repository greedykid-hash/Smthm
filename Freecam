--[[ FREECAM w/ ZOOM (Rayfield UI) ------------------------------------------------------ Place as a LocalScript inside StarterPlayerScripts. Controls: WASD - move E / Q - up / down Left Shift - speed boost Mouse - look around Scroll Wheel- zoom in/out (FOV) Rayfield panel lets you toggle freecam, tune move speed, smoothing (stabilization), and zoom (FOV) with a slider. No external module requires — everything is self-contained, so it works fine under Studio Lite's Play mode limitations. ]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- ===== Load Rayfield =====
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- ===== State =====
local freecamEnabled = false
local freecamCF = camera.CFrame
local targetCF = camera.CFrame

local moveSpeed = 40
local smoothness = 0.15 -- 0.01 = very smooth/slow to settle, 1 = instant/snappy

local fov = 70
local targetFov = 70
local zoomStep = 3
local minFov = 10
local maxFov = 100

local originalCameraType = camera.CameraType
local keysDown = {}

-- ===== Freecam toggle =====
local function setFreecam(state)
	freecamEnabled = state
	if state then
		originalCameraType = camera.CameraType
		freecamCF = camera.CFrame
		targetCF = camera.CFrame
		camera.CameraType = Enum.CameraType.Scriptable
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	else
		camera.CameraType = originalCameraType or Enum.CameraType.Custom
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
end

-- ===== Rayfield Window =====
local Window = Rayfield:CreateWindow({
	Name = "Freecam Controls",
	LoadingTitle = "Freecam",
	LoadingSubtitle = "Photo & Montage Mode",
	ConfigurationSaving = { Enabled = false },
})

local Tab = Window:CreateTab("Freecam")

Tab:CreateToggle({
	Name = "Enable Freecam",
	CurrentValue = false,
	Flag = "FreecamToggle",
	Callback = function(value)
		setFreecam(value)
	end,
})

Tab:CreateSlider({
	Name = "Move Speed",
	Range = { 5, 150 },
	Increment = 1,
	CurrentValue = moveSpeed,
	Flag = "MoveSpeed",
	Callback = function(value)
		moveSpeed = value
	end,
})

Tab:CreateSlider({
	Name = "Stabilization (Smoothness)",
	Range = { 1, 100 },
	Increment = 1,
	CurrentValue = smoothness * 100,
	Flag = "Smoothness",
	Callback = function(value)
		-- lower slider value = smoother/more stable, higher = snappier
		smoothness = value / 100
	end,
})

Tab:CreateSlider({
	Name = "Zoom (FOV)",
	Range = { minFov, maxFov },
	Increment = 1,
	CurrentValue = fov,
	Flag = "FovSlider",
	Callback = function(value)
		targetFov = value
	end,
})

Tab:CreateButton({
	Name = "Reset Zoom",
	Callback = function()
		targetFov = 70
	end,
})

-- ===== Input =====
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	keysDown[input.KeyCode] = true
end)

UserInputService.InputEnded:Connect(function(input)
	keysDown[input.KeyCode] = nil
end)

UserInputService.InputChanged:Connect(function(input)
	if not freecamEnabled then return end

	if input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Delta
		local sensitivity = 0.002
		targetCF = targetCF * CFrame.Angles(0, -delta.X * sensitivity, 0)
		targetCF = targetCF * CFrame.Angles(-delta.Y * sensitivity, 0, 0)

	elseif input.UserInputType == Enum.UserInputType.MouseWheel then
		targetFov = math.clamp(targetFov - input.Position.Z * zoomStep, minFov, maxFov)
		-- keep the Rayfield slider in sync
		if Rayfield.Flags and Rayfield.Flags.FovSlider then
			pcall(function()
				Rayfield.Flags.FovSlider:Set(targetFov)
			end)
		end
	end
end)

-- ===== Update loop (smoothed / stabilized) =====
RunService.RenderStepped:Connect(function(dt)
	if not freecamEnabled then return end

	local moveDir = Vector3.new()
	if keysDown[Enum.KeyCode.W] then moveDir += Vector3.new(0, 0, -1) end
	if keysDown[Enum.KeyCode.S] then moveDir += Vector3.new(0, 0, 1) end
	if keysDown[Enum.KeyCode.A] then moveDir += Vector3.new(-1, 0, 0) end
	if keysDown[Enum.KeyCode.D] then moveDir += Vector3.new(1, 0, 0) end
	if keysDown[Enum.KeyCode.E] then moveDir += Vector3.new(0, 1, 0) end
	if keysDown[Enum.KeyCode.Q] then moveDir += Vector3.new(0, -1, 0) end

	local speedMultiplier = keysDown[Enum.KeyCode.LeftShift] and 3 or 1

	if moveDir.Magnitude > 0 then
		moveDir = moveDir.Unit
		local worldMove = targetCF:VectorToWorldSpace(moveDir) * moveSpeed * speedMultiplier * dt
		targetCF = targetCF + worldMove
	end

	-- exponential smoothing keeps the camera from snapping/jittering
	freecamCF = freecamCF:Lerp(targetCF, math.clamp(smoothness, 0.01, 1))
	fov = fov + (targetFov - fov) * math.clamp(smoothness, 0.01, 1)

	camera.CFrame = freecamCF
	camera.FieldOfView = fov
end)

-- ===== Safety: exit freecam on respawn =====
player.CharacterAdded:Connect(function()
	if freecamEnabled then
		setFreecam(false)
		if Rayfield.Flags and Rayfield.Flags.FreecamToggle then
			pcall(function()
				Rayfield.Flags.FreecamToggle:Set(false)
			end)
		end
	end
end)
