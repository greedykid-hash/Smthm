-- Utility Functions
local function GetCharacter(plr)
   return plr.Character or plr.CharacterAdded:Wait()
end

local function GetHumanoidRootPart(plr)
   local char = GetCharacter(plr)
   return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
end

local function GetHumanoid(plr)
   local char = GetCharacter(plr)
   return char:FindFirstChild("Humanoid")
end

local function IsPlayerDown(plr)
   local hum = GetHumanoid(plr)
   if hum then
      return hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead
   end
   return false
end

local function TeleportToPlayer(plr)
   local targetRoot = GetHumanoidRootPart(plr)
   local myRoot = GetHumanoidRootPart(Player)
   if targetRoot and myRoot then
      myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, -3)
   end
end

local function LootPlayer(plr)
   -- Simulate "Loot All" action
   -- Find the loot GUI or remote event
   local char = GetCharacter(plr)
   local backpack = char:FindFirstChild("Backpack") or char:FindFirstChild("Inventory")
   if backpack then
      for _, item in pairs(backpack:GetChildren()) do
         if item:IsA("Tool") or item:IsA("Part") then
            -- Simulate clicking or remote event
            local remote = item:FindFirstChild("RemoteEvent") or item:FindFirstChild("ClickDetector")
            if remote then
               remote:FireServer(item)
            end
         end
      end
   end
   -- Also try to steal money directly if there's a money value
   local money = char:FindFirstChild("Money") or char:FindFirstChild("Cash")
   if money then
      -- Example: if there's a remote for taking money
      local remote = game:GetService("ReplicatedStorage"):FindFirstChild("TakeMoney")
      if remote then
         remote:FireServer(plr, money.Value)
      end
   end
end

-- Main Loop for Auto Loot
coroutine.wrap(function()
   while wait(Settings.AutoLootDelay) do
      if Settings.AutoLoot then
         for _, plr in pairs(game:GetService("Players"):GetPlayers()) do
            if plr ~= Player and IsPlayerDown(plr) then
               if Settings.TeleportToPlayer then
                  TeleportToPlayer(plr)
                  wait(0.2)
               end
               LootPlayer(plr)
            end
         end
      end
   end
end)()

